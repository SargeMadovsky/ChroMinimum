+def depfile_path(path):
+    # Git worktree metadata may live on a different Windows drive.
+    try:
+        value = os.path.relpath(path)
+    except ValueError:
+        value = os.path.abspath(path)
+    return (value.replace('\\', '/').replace('$', '$$')
+            .replace(' ', '\\ ').replace('#', '\\#').replace(':', '\\:'))
+
