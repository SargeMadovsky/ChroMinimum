--- a/third_party/ffmpeg/libavcodec/aac_ac3_parser.c
+++ b/third_party/ffmpeg/libavcodec/aac_ac3_parser.c
@@ -24,10 +24,55 @@
 
 #include "libavutil/channel_layout.h"
 #include "libavutil/common.h"
+#include "libavutil/error.h"
+#include "libavutil/mem.h"
 #include "parser.h"
 #include "aac_ac3_parser.h"
 #include "ac3_parser_internal.h"
 #include "adts_header.h"
+
+#if CONFIG_AAC_PARSER && !CONFIG_AAC_DECODER
+/* Populate only metadata, not PCM, for explicit AAC-LC ADTS configurations. */
+static int adts_set_demux_config(AVCodecContext *avctx,
+                                const AACADTSHeaderInfo *hdr)
+{
+    static const uint64_t layouts[] = {
+        0, AV_CH_LAYOUT_MONO, AV_CH_LAYOUT_STEREO,
+        AV_CH_LAYOUT_SURROUND, AV_CH_LAYOUT_4POINT0,
+        AV_CH_LAYOUT_5POINT0_BACK, AV_CH_LAYOUT_5POINT1_BACK,
+        AV_CH_LAYOUT_7POINT1_WIDE_BACK,
+    };
+    uint8_t asc[2];
+    if (hdr->object_type != 2 || hdr->num_aac_frames != 1 ||
+        hdr->chan_config < 1 || hdr->chan_config > 7)
+        return AVERROR_INVALIDDATA;
+    asc[0] = (hdr->object_type << 3) | (hdr->sampling_index >> 1);
+    asc[1] = (hdr->sampling_index << 7) | (hdr->chan_config << 3);
+    if (avctx->extradata_size) {
+        if (avctx->extradata_size != 2 || !avctx->extradata ||
+            memcmp(avctx->extradata, asc, 2))
+            return AVERROR_INVALIDDATA;
+    } else {
+        uint8_t *data = av_mallocz(2 + AV_INPUT_BUFFER_PADDING_SIZE);
+        if (!data)
+            return AVERROR(ENOMEM);
+        memcpy(data, asc, 2);
+        av_freep(&avctx->extradata);
+        avctx->extradata = data;
+        avctx->extradata_size = 2;
+    }
+    if (!avctx->sample_rate)
+        avctx->sample_rate = hdr->sample_rate;
+    if (!avctx->ch_layout.nb_channels) {
+        av_channel_layout_uninit(&avctx->ch_layout);
+        if (av_channel_layout_from_mask(&avctx->ch_layout,
+                                       layouts[hdr->chan_config]) < 0)
+            return AVERROR_INVALIDDATA;
+    }
+    avctx->frame_size = hdr->samples;
+    return 0;
+}
+#endif
 
 int ff_aac_ac3_parse(AVCodecParserContext *s1,
                      AVCodecContext *avctx,
@@ -152,6 +197,15 @@
                 ff_adts_header_parse_buf(buf, &hdr) < 0)
                 return i;
 
+#if !CONFIG_AAC_DECODER
+            if (adts_set_demux_config(avctx, &hdr) < 0) {
+                /* Parser callbacks return consumed bytes, not AVERROR codes. */
+                *poutbuf = NULL;
+                *poutbuf_size = 0;
+                return i;
+            }
+            s1->duration = hdr.samples;
+#endif
             if (avctx->profile == AV_PROFILE_UNKNOWN)
                 avctx->profile = hdr.object_type - 1;
             /* ADTS does not support USAC */
