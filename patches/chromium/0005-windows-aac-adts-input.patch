-bool PopulateInputSample(IMFSample* sample, const DecoderBuffer& input) {
+// MSE's MP4 parser can prefix AAC samples with ADTS. The Windows MFT is
+// configured for RAW AAC, while ordinary MP4 demuxing can already provide RAW.
+// Accept one complete ADTS frame; never strip bytes from a partial frame.
+std::optional<size_t> GetAacPayloadOffset(base::span<const uint8_t> data) {
+  if (data.size() < 2 || data[0] != 0xff || (data[1] & 0xf0) != 0xf0) {
+    return 0;
+  }
+  if (data.size() < 7 || (data[1] & 0x06) != 0 ||
+      ((data[2] >> 2) & 0x0f) >= 13 || (data[6] & 0x03) != 0) {
+    return std::nullopt;
+  }
+  const size_t header_size = (data[1] & 1) ? 7 : 9;
+  const size_t frame_size = (static_cast<size_t>(data[3] & 3) << 11) |
+                            (static_cast<size_t>(data[4]) << 3) |
+                            (data[5] >> 5);
+  if (frame_size != data.size() || frame_size <= header_size) {
+    return std::nullopt;
+  }
+  return header_size;
+}
+
+bool PopulateInputSample(IMFSample* sample,
+                         const DecoderBuffer& input,
+                         base::span<const uint8_t> payload) {
   Microsoft::WRL::ComPtr<IMFMediaBuffer> buffer;
   HRESULT hr = sample->GetBufferByIndex(0, &buffer);
   RETURN_ON_HR_FAILURE(hr, "Failed to get buffer from sample", false);
