+void AudioFileReader::OpenAsync(
+    std::unique_ptr<AudioDecoder> decoder,
+    base::OnceCallback<void(bool)> callback) {
+  CHECK(!decoder_ && !glue_ && !async_open_cb_ && !async_read_cb_);
+  AudioDecoderConfig config;
+  if (!decoder || !OpenDemuxer() || !ReadConfig(&config)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), false));
+    return;
+  }
+  decoder_ = std::move(decoder);
+  config_ = std::move(config);
+  async_open_cb_ = std::move(callback);
+  decoder_->Initialize(
+      *config_, nullptr,
+      base::BindOnce(&AudioFileReader::OnAsyncOpened, weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&AudioFileReader::OnOutput, weak_factory_.GetWeakPtr()),
+      base::DoNothing());
+}
+
+void AudioFileReader::OnAsyncOpened(DecoderStatus status) {
+  std::move(async_open_cb_).Run(status.is_ok());
+}
+
+void AudioFileReader::ReadAsync(AsyncReadCB callback) {
+  CHECK(decoder_ && config_ && !async_open_cb_ && !async_read_cb_);
+  async_audio_packets_.clear();
+  decoded_audio_packets_ = &async_audio_packets_;
+  num_frames_emitted_ = 0;
+  on_output_error_ = false;
+  async_read_cb_ = std::move(callback);
+  ReadNextAsyncPacket();
+}
+
+void AudioFileReader::ReadNextAsyncPacket() {
+  auto packet = ScopedAVPacket::Allocate();
+  const bool eos = !ReadPacket(packet.get());
+  auto buffer = eos ? DecoderBuffer::CreateEOSBuffer() : MakeDecoderBuffer(packet);
+  decoder_->Decode(
+      std::move(buffer),
+      base::BindOnce(&AudioFileReader::OnAsyncDecoded,
+                     weak_factory_.GetWeakPtr(), eos));
+}
+
+void AudioFileReader::OnAsyncDecoded(bool eos, DecoderStatus status) {
+  if (!status.is_ok() || on_output_error_ || eos) {
+    FinishAsyncRead(status.is_ok() && !on_output_error_);
+    return;
+  }
+  // Post rather than recurse: also tolerates synchronous test decoders and
+  // allows cancellation between packets without an unbounded packet queue.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&AudioFileReader::ReadNextAsyncPacket,
+                               weak_factory_.GetWeakPtr()));
+}
+
+void AudioFileReader::FinishAsyncRead(bool success) {
+  if (pending_output_buffer_) {
+    FinalizeDecodedBuffer(std::move(pending_output_buffer_), success);
+  }
+  decoded_audio_packets_ = nullptr;
+  auto callback = std::move(async_read_cb_);
+  auto packets = std::move(async_audio_packets_);
+  std::move(callback).Run(success, std::move(packets));
+}
