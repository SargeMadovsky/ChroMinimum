+namespace {
+struct AsyncReaderCounts { int decodes = 0; int eos = 0; };
+// Delayed callbacks model Mojo scheduling; this is not a PCM/codec test.
+class AsyncReaderTestDecoder final : public AudioDecoder {
+ public:
+  AsyncReaderTestDecoder(AsyncReaderCounts* counts, bool disconnected)
+      : counts_(counts), disconnected_(disconnected) {}
+  AudioDecoderType GetDecoderType() const override { return AudioDecoderType::kTesting; }
+  void Initialize(const AudioDecoderConfig&, CdmContext*, InitCB callback,
+                  const OutputCB&, const WaitingCB&) override {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), DecoderStatus::Codes::kOk));
+  }
+  void Decode(scoped_refptr<DecoderBuffer> buffer, DecodeCB callback) override {
+    ++counts_->decodes;
+    if (buffer->end_of_stream()) ++counts_->eos;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback),
+          disconnected_ ? DecoderStatus::Codes::kDisconnected : DecoderStatus::Codes::kOk));
+  }
+  void Reset(base::OnceClosure callback) override {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, std::move(callback));
+  }
+ private:
+  raw_ptr<AsyncReaderCounts> counts_;
+  bool disconnected_;
+};
+}
+
+TEST(AsyncAudioFileReaderTest, DelayedDecodeAndEos) {
+  base::test::TaskEnvironment tasks;
+  auto data = ReadTestDataFile("bear-audio-lc-aac.aac");
+  InMemoryUrlProtocol protocol(*data, false);
+  AudioFileReader reader(&protocol);
+  AsyncReaderCounts counts;
+  int open_calls = 0, read_calls = 0;
+  bool opened = false, read_ok = false;
+  reader.OpenAsync(std::make_unique<AsyncReaderTestDecoder>(&counts, false),
+      base::BindLambdaForTesting([&](bool ok) { ++open_calls; opened = ok; }));
+  EXPECT_EQ(open_calls, 0);
+  tasks.RunUntilIdle();
+  ASSERT_TRUE(opened);
+  reader.ReadAsync(base::BindLambdaForTesting(
+      [&](bool ok, std::vector<std::unique_ptr<AudioBus>> packets) {
+        ++read_calls; read_ok = ok; EXPECT_TRUE(packets.empty());
+      }));
+  EXPECT_EQ(read_calls, 0);
+  tasks.RunUntilIdle();
+  EXPECT_EQ(open_calls, 1);
+  EXPECT_EQ(read_calls, 1);
+  EXPECT_TRUE(read_ok);
+  EXPECT_GT(counts.decodes, 1);
+  EXPECT_EQ(counts.eos, 1);
+}
+
+TEST(AsyncAudioFileReaderTest, DisconnectStopsBeforeEos) {
+  base::test::TaskEnvironment tasks;
+  auto data = ReadTestDataFile("bear-audio-lc-aac.aac");
+  InMemoryUrlProtocol protocol(*data, false);
+  AudioFileReader reader(&protocol);
+  AsyncReaderCounts counts;
+  reader.OpenAsync(std::make_unique<AsyncReaderTestDecoder>(&counts, true),
+      base::BindLambdaForTesting([](bool ok) { EXPECT_TRUE(ok); }));
+  tasks.RunUntilIdle();
+  int callbacks = 0;
+  reader.ReadAsync(base::BindLambdaForTesting(
+      [&](bool ok, std::vector<std::unique_ptr<AudioBus>> packets) {
+        ++callbacks; EXPECT_FALSE(ok); EXPECT_TRUE(packets.empty());
+      }));
+  tasks.RunUntilIdle();
+  EXPECT_EQ(callbacks, 1);
+  EXPECT_EQ(counts.decodes, 1);
+  EXPECT_EQ(counts.eos, 0);
+}
+
+TEST(AsyncAudioFileReaderTest, DestructionCancelsPendingOpenOnce) {
+  base::test::TaskEnvironment tasks;
+  auto data = ReadTestDataFile("bear-audio-lc-aac.aac");
+  InMemoryUrlProtocol protocol(*data, false);
+  auto reader = std::make_unique<AudioFileReader>(&protocol);
+  AsyncReaderCounts counts;
+  int callbacks = 0;
+  reader->OpenAsync(std::make_unique<AsyncReaderTestDecoder>(&counts, false),
+      base::BindLambdaForTesting([&](bool ok) { ++callbacks; EXPECT_FALSE(ok); }));
+  reader.reset();
+  tasks.RunUntilIdle();
+  EXPECT_EQ(callbacks, 1);
+  EXPECT_EQ(counts.decodes, 0);
+}
