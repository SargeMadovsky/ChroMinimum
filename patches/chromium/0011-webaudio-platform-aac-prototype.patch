+namespace {
+using DecodedPackets = std::vector<std::unique_ptr<media::AudioBus>>;
+using AsyncDecodeCB = base::OnceCallback<void(DecodedPackets, int)>;
+
+// Cancellation is an event, not a polling loop. No Blink/GC pointers here.
+class AudioFileCancellation
+    : public base::RefCountedThreadSafe<AudioFileCancellation> {
+ public:
+  void Cancel() {
+    base::OnceClosure callback;
+    scoped_refptr<base::SequencedTaskRunner> runner;
+    {
+      base::AutoLock guard(lock_);
+      cancelled_ = true;
+      callback = std::move(callback_);
+      runner = runner_;
+    }
+    if (callback) runner->PostTask(FROM_HERE, std::move(callback));
+  }
+  void Bind(scoped_refptr<base::SequencedTaskRunner> runner,
+            base::OnceClosure callback) {
+    bool cancelled;
+    {
+      base::AutoLock guard(lock_);
+      cancelled = cancelled_;
+      if (!cancelled) {
+        runner_ = runner;
+        callback_ = std::move(callback);
+      }
+    }
+    if (cancelled) runner->PostTask(FROM_HERE, std::move(callback));
+  }
+  void Clear() {
+    base::AutoLock guard(lock_);
+    callback_.Reset();
+    runner_.reset();
+  }
+ private:
+  friend class base::RefCountedThreadSafe<AudioFileCancellation>;
+  ~AudioFileCancellation() = default;
+  base::Lock lock_;
+  bool cancelled_ GUARDED_BY(lock_) = false;
+  scoped_refptr<base::SequencedTaskRunner> runner_ GUARDED_BY(lock_);
+  base::OnceClosure callback_ GUARDED_BY(lock_);
+};
+
+#if BUILDFLAG(ENABLE_MOJO_AUDIO_DECODER)
+class AsyncAudioFileRequest
+    : public base::RefCountedDeleteOnSequence<AsyncAudioFileRequest> {
+ public:
+  AsyncAudioFileRequest(
+      scoped_refptr<base::SequencedTaskRunner> runner,
+      std::vector<uint8_t> data,
+      scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy> broker,
+      scoped_refptr<AudioFileCancellation> cancellation, AsyncDecodeCB callback)
+      : base::RefCountedDeleteOnSequence<AsyncAudioFileRequest>(runner),
+        runner_(std::move(runner)), data_(std::move(data)),
+        broker_(std::move(broker)), cancellation_(std::move(cancellation)),
+        callback_(std::move(callback)) {}
+
+  void Start() {
+    cancellation_->Bind(runner_, base::BindOnce(
+        &AsyncAudioFileRequest::Cancel, weak_factory_.GetWeakPtr()));
+    // Prototype deadline: not yet a release compatibility policy.
+    deadline_.Start(FROM_HERE, base::Seconds(30), base::BindOnce(
+        &AsyncAudioFileRequest::Cancel, weak_factory_.GetWeakPtr()));
+    protocol_ = std::make_unique<InMemoryUrlProtocol>(data_, false);
+    reader_ = std::make_unique<AudioFileReader>(protocol_.get());
+    reader_->OpenAsync(
+        base::BindOnce(&AsyncAudioFileRequest::CreateDecoder,
+                       base::Unretained(this)),
+        base::BindOnce(&AsyncAudioFileRequest::OnOpened,
+                       scoped_refptr<AsyncAudioFileRequest>(this)));
+  }
+ private:
+  friend class base::RefCountedDeleteOnSequence<AsyncAudioFileRequest>;
+  friend class base::DeleteHelper<AsyncAudioFileRequest>;
+  ~AsyncAudioFileRequest() = default;
+
+  std::unique_ptr<media::AudioDecoder> CreateDecoder() {
+    if (!broker_) return nullptr;
+    broker_->GetInterface(factory_.BindNewPipeAndPassReceiver());
+    mojo::PendingRemote<media::mojom::AudioDecoder> remote;
+    factory_->CreateAudioDecoder(remote.InitWithNewPipeAndPassReceiver());
+    return std::make_unique<media::MojoAudioDecoder>(
+        runner_, &media_log_, std::move(remote));
+  }
+  void OnOpened(bool success) {
+    if (!callback_) return;
+    if (!success) { Finish({}, 0); return; }
+    reader_->ReadAsync(base::BindOnce(&AsyncAudioFileRequest::OnRead,
+                                    scoped_refptr<AsyncAudioFileRequest>(this)));
+  }
+  void OnRead(bool success, DecodedPackets packets) {
+    if (!callback_) return;
+    const int sample_rate = reader_->sample_rate();
+    if (!success) packets.clear();
+    Finish(std::move(packets), sample_rate);
+  }
+  void Cancel() { Finish({}, 0); }
+  void Finish(DecodedPackets packets, int sample_rate) {
+    if (!callback_) return;
+    deadline_.Stop();
+    weak_factory_.InvalidateWeakPtrs();
+    cancellation_->Clear();
+    reader_->Close();
+    factory_.reset();
+    auto callback = std::move(callback_);
+    std::move(callback).Run(std::move(packets), sample_rate);
+  }
+
+  scoped_refptr<base::SequencedTaskRunner> runner_;
+  std::vector<uint8_t> data_;
+  scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy> broker_;
+  scoped_refptr<AudioFileCancellation> cancellation_;
+  AsyncDecodeCB callback_;
+  media::NullMediaLog media_log_;
+  mojo::Remote<media::mojom::InterfaceFactory> factory_;
+  std::unique_ptr<InMemoryUrlProtocol> protocol_;
+  std::unique_ptr<AudioFileReader> reader_;
+  base::OneShotTimer deadline_;
+  base::WeakPtrFactory<AsyncAudioFileRequest> weak_factory_{this};
+};
+#endif
+}  // namespace
+
+base::OnceClosure DecodeAudioFileDataAsync(
+    std::vector<uint8_t> data,
+    scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy> broker,
+    AsyncDecodeCB callback) {
+#if BUILDFLAG(ENABLE_MOJO_AUDIO_DECODER)
+  auto runner = base::ThreadPool::CreateSequencedTaskRunner(
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE});
+  auto cancellation = base::MakeRefCounted<AudioFileCancellation>();
+  runner->PostTask(FROM_HERE, base::BindOnce(
+      [](scoped_refptr<base::SequencedTaskRunner> runner,
+         std::vector<uint8_t> data,
+         scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy> broker,
+         scoped_refptr<AudioFileCancellation> cancellation,
+         AsyncDecodeCB callback) {
+        auto request = base::MakeRefCounted<AsyncAudioFileRequest>(
+            std::move(runner), std::move(data), std::move(broker),
+            std::move(cancellation), std::move(callback));
+        request->Start();
+      }, runner, std::move(data), std::move(broker), cancellation,
+      std::move(callback)));
+  return base::BindOnce(&AudioFileCancellation::Cancel, cancellation);
+#else
+  std::move(callback).Run({}, 0);
+  return base::DoNothing();
+#endif
+}
