+                          MakeUnwrappingCrossThreadHandle(error_callback),
+                          blink::RetainedRef(std::move(bus)),
+                          MakeUnwrappingCrossThreadHandle(resolver),
+                          MakeUnwrappingCrossThreadHandle(context)));
+}
