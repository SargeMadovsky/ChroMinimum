+          offset += base::checked_cast<size_t>(packet->frames());
+        }
+      }
+    }
+  }
+  packets.clear();
+  if (bus && bus->SampleRate() != target_sample_rate) {
+    bus = AudioBus::TryCreateBySampleRateConverting(
+        bus.get(), false, target_sample_rate);
+  }
