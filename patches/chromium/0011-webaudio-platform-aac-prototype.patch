+void FinishPlatformAudioDecode(
+    float target_sample_rate,
+    CrossThreadHandle<V8DecodeSuccessCallback> success_callback,
+    CrossThreadHandle<V8DecodeErrorCallback> error_callback,
+    CrossThreadHandle<ScriptPromiseResolver<AudioBuffer>> resolver,
+    CrossThreadHandle<BaseAudioContext> context,
+    scoped_refptr<base::SingleThreadTaskRunner> task_runner,
+    std::vector<std::unique_ptr<media::AudioBus>> packets, int sample_rate) {
+  scoped_refptr<AudioBus> bus;
+  if (!packets.empty() && sample_rate >= media::limits::kMinSampleRate &&
+      sample_rate <= media::limits::kMaxSampleRate) {
+    const int channels = packets.front()->channels();
+    base::CheckedNumeric<uint32_t> frames = 0;
+    bool valid = channels > 0 && channels <= media::limits::kMaxChannels;
+    for (const auto& packet : packets) {
+      valid &= packet->channels() == channels && packet->frames() > 0;
+      frames += packet->frames();
+    }
+    if (valid && frames.IsValid() && frames.ValueOrDie() > 0) {
+      bus = AudioBus::TryCreate(channels, frames.ValueOrDie());
+      if (bus) {
+        bus->SetSampleRate(sample_rate);
+        size_t offset = 0;
+        for (const auto& packet : packets) {
+          for (int channel = 0; channel < channels; ++channel) {
+            bus->Channel(channel)->MutableSpan()
+                .subspan(offset, base::checked_cast<size_t>(packet->frames())).copy_from(packet->channel(channel));
