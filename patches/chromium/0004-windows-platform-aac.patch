+#if BUILDFLAG(USE_PROPRIETARY_CODECS)
+    if (InitializeMediaFoundation()) {
+      // Probe decoder availability: Windows N may not include the AAC MFT.
+      MFT_REGISTER_TYPE_INFO aac_type = {MFMediaType_Audio, MFAudioFormat_AAC};
+      IMFActivate** activations = nullptr;
+      UINT32 count = 0;
+      const HRESULT hr = MFTEnumEx(
+          MFT_CATEGORY_AUDIO_DECODER,
+          MFT_ENUM_FLAG_SYNCMFT | MFT_ENUM_FLAG_LOCALMFT |
+              MFT_ENUM_FLAG_SORTANDFILTER,
+          &aac_type, nullptr, &activations, &count);
+      if (SUCCEEDED(hr)) {
+        if (count > 0) {
+          audio_configs.emplace_back(AudioCodec::kAAC,
+                                     AudioCodecProfile::kUnknown);
+          if (base::win::GetVersion() >= base::win::Version::WIN11_22H2) {
+            audio_configs.emplace_back(AudioCodec::kAAC,
+                                       AudioCodecProfile::kXHE_AAC);
+          }
+        }
+        for (UINT32 index = 0; index < count; ++index) {
+          // SAFETY: MFTEnumEx returns an array of count IMFActivate pointers.
+          UNSAFE_TODO(activations[index])->Release();
+        }
+      }
+      CoTaskMemFree(activations);
+    }
+#endif  // BUILDFLAG(USE_PROPRIETARY_CODECS)
 
     return audio_configs;
   }
