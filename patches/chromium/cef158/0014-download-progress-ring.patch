+bool UpdateChroMinimumDownloadRing(views::View& anchor,
+                                   ActionItemProgressRingStatus status,
+                                   int progress_percentage,
+                                   bool is_active,
+                                   bool log_paint) {
+  DownloadProgressRing& ring = DownloadProgressRing::GetOrInstall(anchor);
+  ring.SetLogPaint(log_paint);
+  ring.SetBoundsRect(anchor.GetLocalBounds());
+  if (status == ActionItemProgressRingStatus::kIdle) {
+    ring.SetIdle();
+    return ring.IsDrawn();
+  }
+  const ui::ColorProvider* colors = anchor.GetColorProvider();
+  CHECK(colors);
+  const bool is_dormant = status == ActionItemProgressRingStatus::kDormant;
+  const SkColor disabled = colors->GetColor(kColorToolbarButtonIconInactive);
+  ring.UpdateColors(
+      is_dormant ? disabled
+                 : colors->GetColor(kColorDownloadToolbarButtonRingBackground),
+      is_dormant ? disabled
+                 : colors->GetColor(is_active
+                                        ? kColorDownloadToolbarButtonActive
+                                        : kColorDownloadToolbarButtonInactive));
+  if (is_dormant) {
+    ring.SetDormant();
+  } else if (status == ActionItemProgressRingStatus::kScanning) {
+    ring.SetScanning();
+  } else {
+    ring.SetDownloading(progress_percentage);
+  }
+  return ring.IsDrawn();
+}
