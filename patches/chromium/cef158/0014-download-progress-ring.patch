 void DownloadToolbarUIController::UpdateIcon() {
+  // The CEF toolbar has its own button; reuse the native progress renderer
+  // and event-driven controller state, without touching the complete bubble.
+  if (auto* anchor = GetChroMinimumDownloadAnchor(browser_view_)) {
+    redraw_progress_soon_ = false;
+    ActionItemProgressRingStatus status;
+    if (state_ == IconState::kComplete || progress_info_.download_count == 0) {
+      status = ActionItemProgressRingStatus::kIdle;
+    } else if (is_dormant_) {
+      status = ActionItemProgressRingStatus::kDormant;
+    } else if (ShouldShowScanningAnimation()) {
+      status = ActionItemProgressRingStatus::kScanning;
+    } else {
+      status = ActionItemProgressRingStatus::kDownloading;
+    }
+    const bool probe = IsChroMinimumDownloadProbe();
+    const bool drawn = UpdateChroMinimumDownloadRing(
+        *anchor, status, progress_info_.progress_percentage,
+        active_ == IconActive::kActive, probe);
+    if (probe) {
+      LOG(INFO) << "CM_DOWNLOAD_RING state=" << static_cast<int>(status)
+                << " count=" << progress_info_.download_count
+                << " percent=" << progress_info_.progress_percentage
+                << " drawn=" << drawn;
+    }
+    return;
+  }
